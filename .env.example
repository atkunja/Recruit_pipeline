# ---------------------------------------------------------------------------
# Recruiting Pipeline — environment
# Copy to `.env.local` for development. Set the same keys in Vercel for prod.
# ---------------------------------------------------------------------------

# --- Database (Supabase) ---------------------------------------------------
# Use the *Transaction pooler* connection string (port 6543) from
# Supabase → Project Settings → Database → Connection string → URI.
# The pooler is required for serverless; prepared statements are disabled in
# src/lib/db.ts to match.
DATABASE_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres"

# Direct (session, port 5432) connection — used only by `npm run db:migrate`,
# because DDL over the transaction pooler is unreliable.
DIRECT_DATABASE_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# --- Single-user auth ------------------------------------------------------
# The password you type to get in. Any non-empty string.
APP_PASSWORD="change-me"
# Random 32+ char secret used to sign the session cookie.
# Generate with: openssl rand -base64 32
AUTH_SECRET="change-me-to-a-long-random-string"

# --- Model provider --------------------------------------------------------
OPENAI_API_KEY="sk-..."

# Optional. Any OpenAI-compatible endpoint. Leave unset to use OpenAI.
#   Moonshot (Kimi):  https://api.moonshot.ai/v1
#   Together:         https://api.together.xyz/v1
#   Groq:             https://api.groq.com/openai/v1
#   OpenRouter:       https://openrouter.ai/api/v1
# If you set this, also set the two model names below to ids that provider
# knows, and check src/lib/ai/pricing.ts has a rate for them — an unpriced
# model is billed at a pessimistic default and will trip the budget guard.
# OPENAI_BASE_URL="https://api.moonshot.ai/v1"
# Cheap model: classification, prefilter assist, email triage, batch scoring.
OPENAI_MODEL_CHEAP="gpt-4.1-mini"
# Strong model: resume tailoring, outreach writing, application answers.
OPENAI_MODEL_STRONG="gpt-4.1"
# Hard monthly ceiling in USD. When exceeded, AI routes return 429 instead of
# spending money. Set to 0 to disable the guard.
OPENAI_MONTHLY_BUDGET_USD="20"

# --- Cron ------------------------------------------------------------------
# Random string; Vercel Cron sends it as a bearer token to /api/cron/*.
# Generate with: openssl rand -hex 24
CRON_SECRET="change-me"

# --- Gmail (Phase 3) -------------------------------------------------------
# Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client ID
# (type: Web application). Authorized redirect URI must be
#   http://localhost:3000/api/gmail/callback           (dev)
#   https://<your-app>.vercel.app/api/gmail/callback   (prod)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:3000/api/gmail/callback"

# --- App -------------------------------------------------------------------
# Public base URL. Used for OAuth redirects and links in emails.
NEXT_PUBLIC_APP_URL="http://localhost:3000"
