{
  "name": "recruiting-pipeline",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "description": "Personal AI recruiting operating system \u2014 single user.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "deploy": "bash scripts/deploy.sh",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "node --import ./test/register.mjs --test \"test/**/*.test.ts\"",
    "setup": "node scripts/setup-env.ts",
    "db:check": "node scripts/check-db.ts",
    "db:migrate": "node scripts/migrate.ts",
    "db:seed": "node scripts/seed.ts",
    "db:refilter": "node --import ./test/register.mjs scripts/refilter.ts",
    "db:redupe": "node --import ./test/register.mjs scripts/redupe.ts",
    "db:pay": "node --import ./test/register.mjs scripts/backfill-pay.ts",
    "discover": "node scripts/discover.ts",
    "apply": "node scripts/apply.ts"
  },
  "dependencies": {
    "googleapis": "174.0.1",
    "next": "16.3.0",
    "openai": "7.4.0",
    "pdf-lib": "1.17.1",
    "postgres": "3.4.9",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.0",
    "playwright": "1.62.1",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=20.9.0"
  }
}
